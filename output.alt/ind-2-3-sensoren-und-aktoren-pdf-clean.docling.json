      "orig": "2.1. Unzureichende Sicherheitsanforderungen bei der Beschaffung",
      "text": "2.1. Unzureichende Sicherheitsanforderungen bei der Beschaffung",
      "level": 1
    },
    {
      "self_ref": "#/texts/17",
      "parent": {
        "$ref": "#/body"
      },
      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [
        {
          "page_no": 2,
          "bbox": {
            "l": 56.64,
            "t": 614.3376000000001,
            "r": 531.8236799999984,
            "b": 538.8835294117647,
