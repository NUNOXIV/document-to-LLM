      ],
      "orig": "Quelle: Bundesamt für Sicherheit in der Informationstechnik",
      "text": "Quelle: Bundesamt für Sicherheit in der Informationstechnik"
    },
    {
      "self_ref": "#/texts/7",
      "parent": {
        "$ref": "#/body"
      },
      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [
        {
          "page_no": 2,
          "bbox": {
            "l": 44.496091895996095,
